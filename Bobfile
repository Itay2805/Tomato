# vim: syntax=python

from pathlib import Path

import bobstd.c as c
from bob.prelude import *

bob_required_version("0.1.0")
bob_required_package_version("bobstd", "0.2.0")

ARCH = config("ARCH", required=True)

################################################################################
# The kernel
################################################################################

# Setup the main toolchain
c.toolchain(ccbin="clang", arbin="llvm-ar", asbin="clang", ldbin="clang")


# Get the clang include dir
CLANG_INCLUDE_DIR = shell("clang --print-file-name=include", strip=True)

# Set the cflags we use
match ARCH:
    case "x86_64":
        target_flags = [
            "-target",
            "x86_64-none-elf",
            "-march=x86-64-v3",
        ]

        c.cflags.add(
            [
                # Kernel ABI
                "-mgeneral-regs-only",
                "-mno-red-zone",
                "-mcmodel=kernel",
                "-mstack-alignment=8",
            ]
        )

    case "aarch64":
        target_flags = [
            "-target",
            "aarch64-none-elf",
            "-march=armv8.2-a",
        ]

        c.cflags.add(
            [
                # Kernel ABI
                "-mgeneral-regs-only",
            ]
        )

    case _:
        raise ValueError(f"Unknown arch {ARCH}")

c.cflags.add(target_flags)

# The assembly files don't get the cflags, so give them the
# target and the include paths for the shared headers
c.asflags.add(
    [
        *target_flags,
        "-Iinclude",
        "-Isrc",
        f"-Isrc/arch/{ARCH}",
        "-g",
    ]
)


c.cflags.add(
    [
        # All the errors
        "-Wall",
        "-Wextra",
        "-Werror",
        # C23 + defer extension
        "-std=gnu23",
        "-fdefer-ts",
        # Only use the clang freestanding headers
        "-nostdinc",
        "-isystem",
        CLANG_INCLUDE_DIR,
        "-Iinclude",
        "-Isrc",
        f"-Isrc/arch/{ARCH}",
        # Easier debugging, regardless of level
        "-g",
        # All code is internal
        "-fvisibility=hidden",
        # static reloctable binary
        "-static",
        "-fno-common",
        # memory model
        "-fpic",
        "-fno-plt",
        # Kernel compatible code gen
        "-ffreestanding",
        "-fno-builtin",
        # Strong stack protector
        "-fstack-protector-strong",
        # Only allow C99 flexible arrays
        "-fstrict-flex-arrays=3",
        # To make the code less prone to mistakes
        "-fno-strict-overflow",
        "-fno-strict-aliasing",
        # Standard sizes
        "-fshort-wchar",
        "-funsigned-char",
        # We have no use for these tables
        "-fno-unwind-tables",
        "-fno-asynchronous-unwind-tables",
    ]
)

c.ldflags.add(
    [
        # Use clang's ld
        "-fuse-ld=lld",
        # No libs
        "-nostdlib",
        # Make sure all errors are fatal
        "-Wl,--fatal-warnings",
        # Don't add the build id (useless)
        "-Wl,--build-id=none",
        # Add our linker script
        "-Tsrc/linker.lds",
        # The linker script aligns the sections to the max page size and counts them in
        # pages, so it must match our page size (lld defaults to 64kb on aarch64)
        "-Wl,-z,max-page-size=4096",
        # Keep the relocations so we can check nothing references init code
        "-Wl,--emit-relocs",
    ]
)

kernel_cflags: list[str] = []

# If we are compiled for debug
if config("DEBUG") == "y":
    # Debugging flags
    c.cflags.add(
        [
            # Tell the code we are in debug
            "-D__DEBUG__",
            # Optimize for debugging
            "-Og",
            # Add frame pointers
            "-fno-omit-frame-pointer",
            "-fno-optimize-sibling-calls",
            # Init all stack variables to a pattern
            "-ftrivial-auto-var-init=pattern",
        ]
    )
else:
    # Optimization flags
    c.cflags.add(
        [
            # Optimizations and full lto please
            "-O3",
            # Frame pointers are not needed
            "-fomit-frame-pointer",
            # Zero init all stack variables
            "-ftrivial-auto-var-init=zero",
        ]
    )

    # we want the kernel to have lto
    kernel_cflags.append("-flto")

    c.ldflags.add(
        [
            # Make sure we have the max optimization level with lto
            "-Wl,--lto-O3",
        ]
    )

# Split the sources into kernel ones and boot code ones
sources = glob("**/*.c", Path("src")) + glob("**/*.S", Path("src"))

# remove the arch sources not for the current arch
boot_sources: list[Path] = []
to_remove: list[Path] = []
for source in sources:
    parts = source.parts

    # Check if this source is not for the current architecture
    if "arch" in parts:
        idx = parts.index("arch")
        if idx + 1 < len(parts) and parts[idx + 1] != ARCH:
            to_remove.append(source)
            continue

    # Check if the source is only for boot time
    if "boot" in parts:
        boot_sources.append(source)
        to_remove.append(source)

# remove all the required sources
for source in to_remove:
    sources.remove(source)


#
# The boot code, it builds without kasan to make
# it easier to initialize kasan
#
boot_code = c.static_library_bundle(
    name="boot",
    sources=boot_sources,
)

#
# The kernel code, it builds with kasan
#
with c.cflags.add(kernel_cflags):
    kernel_code = c.static_library_bundle(
        name="kernel",
        sources=sources,
    )

# The kernel itself
kernel = c.binary(
    name="kernel.elf",
    implicit=[
        Path("src/linker.lds"),
    ],
    bundles=[boot_code, kernel_code],
    sources=[],
)

python_post_process = Rule(
    "uv run --quiet python $script $in && touch $out", description="PYTHON"
)

init_refs_stamp = python_post_process.build(
    "init-refs.stamp",
    inputs=[
        kernel,
    ],
    variables={
        "script": "tools/check_init_refs.py",
    },
    implicit=[
        Path("tools/check_init_refs.py"),
    ],
)


################################################################################
# Fetch the limine bootloader
################################################################################

# The limine release to use, `latest` always grabs the newest one
LIMINE_VERSION = config("LIMINE_VERSION", default="12.9.3")

# The directory the release is unpacked into
LIMINE_DIR = builddir() / "limine"

# The prebuilt release archive, github serves `latest` from its own path
LIMINE_URL = (
    "https://github.com/limine-bootloader/limine/releases/"
    + (
        "latest/download"
        if LIMINE_VERSION == "latest"
        else f"download/v{LIMINE_VERSION}"
    )
    + "/limine-binary.tar.xz"
)

# Download the prebuilt release from github and unpack it
limine_fetch = Rule(
    "rm -rf $dir $dir.tar.xz"
    " && mkdir -p $dir"
    " && curl -sSfL -o $dir.tar.xz $url"
    " && tar -xJf $dir.tar.xz -C $dir --strip-components=1"
    " && rm -f $dir.tar.xz",
    description="FETCH LIMINE",
    single_output=False,
    variables={
        "url": LIMINE_URL,
        "dir": LIMINE_DIR,
    },
)

# We only care about the pieces for our architecture, the release also carries the
# other architectures, the cd/pxe stages and the headers
match ARCH:
    case "x86_64":
        limine_source, limine_bios_sys, limine_efi = limine_fetch.build(
            "limine/limine.c",
            "limine/limine-bios.sys",
            "limine/BOOTX64.EFI",
        )

        # The only prebuilt deploy tool in the release is for windows, everywhere else
        # it has to be built from the limine.c that ships next to it.
        #
        # This is a host binary and not part of the kernel, so scope the toolchain back
        # to the host and replace the kernel flags with the ones from the Makefile that
        # ships alongside limine.c.
        #
        # It is only needed to install the BIOS stages, so only x86-64 needs it.
        with (
            c.toolchain(ccbin=config("HOSTCC", default="cc"), arbin="ar"),
            c.cflags.set(
                [
                    "-std=c99",
                    "-D_FILE_OFFSET_BITS=64",
                    "-O2",
                ]
            ),
            c.asflags.set([]),
            c.ldflags.set([]),
        ):
            limine_tool = c.binary(name="limine-tool", sources=[limine_source])

    case "aarch64":
        (limine_efi,) = limine_fetch.build(
            "limine/BOOTAA64.EFI",
        )


################################################################################
# The bootable image
################################################################################

# The size of the generated disk image
IMAGE_SIZE = "64M"

# The limine boot menu configuration
LIMINE_CONF = Path("limine.conf")

# The table is laid out as GPT and then converted to MBR (sgdisk `-m`), which
# is what limine wants on x86-64: plenty of BIOS/CSM implementations refuse to
# boot off of GPT, while UEFI is happy to take an ESP on an MBR disk. The UEFI
# executables go into the ESP.
#
# Everything is done with mtools so that no loop device or root is needed.
match ARCH:
    case "x86_64":
        # Build a disk image that boots on both BIOS and UEFI, the BIOS stages go
        # into the MBR and the gap in front of the partition, so the same image
        # boots either way.
        limine_image = Rule(
            "rm -f $out"
            " && truncate -s $size $out"
            " && PATH=$$PATH:/usr/sbin:/sbin sgdisk $out -n 1:2048 -t 1:ef00 -m 1 > /dev/null"
            " && $limine bios-install --quiet $out"
            " && mformat -i $out@@1M"
            " && mmd -i $out@@1M ::/EFI ::/EFI/BOOT ::/boot ::/boot/limine"
            " && mcopy -i $out@@1M $kernel ::/boot"
            " && mcopy -i $out@@1M $conf $biossys ::/boot/limine"
            " && mcopy -i $out@@1M $efi ::/EFI/BOOT",
            description="IMAGE",
            variables={
                "size": IMAGE_SIZE,
            },
        )

        image = limine_image.build(
            "tomato.hdd",
            inputs=[kernel, LIMINE_CONF, limine_bios_sys, limine_efi],
            implicit=[limine_tool, init_refs_stamp],
            variables={
                "limine": limine_tool,
                "kernel": kernel,
                "conf": LIMINE_CONF,
                "biossys": limine_bios_sys,
                "efi": limine_efi,
            },
        )

    case "aarch64":
        # Build a disk image that boots on UEFI, which is the only way to boot
        # limine on aarch64.
        limine_image = Rule(
            "rm -f $out"
            " && truncate -s $size $out"
            " && PATH=$$PATH:/usr/sbin:/sbin sgdisk $out -n 1:2048 -t 1:ef00 -m 1 > /dev/null"
            " && mformat -i $out@@1M"
            " && mmd -i $out@@1M ::/EFI ::/EFI/BOOT ::/boot ::/boot/limine"
            " && mcopy -i $out@@1M $kernel ::/boot"
            " && mcopy -i $out@@1M $conf ::/boot/limine"
            " && mcopy -i $out@@1M $efi ::/EFI/BOOT",
            description="IMAGE",
            variables={
                "size": IMAGE_SIZE,
            },
        )

        image = limine_image.build(
            "tomato.hdd",
            inputs=[kernel, LIMINE_CONF, limine_efi],
            implicit=[init_refs_stamp],
            variables={
                "kernel": kernel,
                "conf": LIMINE_CONF,
                "efi": limine_efi,
            },
        )
